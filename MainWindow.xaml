<Window
    x:Class="WinCalendar.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WinCalendar">
    <Grid x:Name="Surface">
        <Grid x:Name="BackgroundSurface" IsHitTestVisible="False" />
        <Viewbox x:Name="CalendarHost" Stretch="Uniform" StretchDirection="DownOnly"
                 HorizontalAlignment="Stretch" VerticalAlignment="Top" />
    </Grid>
</Window>
